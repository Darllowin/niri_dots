{
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  },
  "terminal": {
    "shell": {
      "program": "/bin/fish"
    }
  },
  "cli_default_open_behavior": "new_window",
  "use_system_prompts": false,
  "use_system_path_prompts": false,
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Zed (Default)"
  },
  "ui_font_family": "Iosevka Nerd Font",
  "buffer_font_family": "Iosevka Nerd Font",
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "terminal_init_command": "",
    "single_file_review": false,
    "commit_message_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-pro"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-pro",
      "enable_thinking": true,
      "effort": "max"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 22,
  "buffer_font_size": 23,
  "theme": {
    "mode": "light",
    "light": "Gruvbox Light",
    "dark": "One Dark",
  },
}
